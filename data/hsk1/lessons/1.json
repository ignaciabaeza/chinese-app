      {
        "number": 1,
        "title": {
          "hanzi": "汉语拼音的声母和韵母 (1)",
          "english": "Initials and Finals of Chinese Pinyin (1)"
        },
        "explanation": {
          "hanzi": "声母 (Initials): b p m f / d t n l / g k h / j q x。韵母 (Finals): i u ü er / a ia ua / o uo / e ie üe / ai uai / ei uei (ui) / ao iao。",
          "english": "Initials introduced in this lesson: b, p, m, f / d, t, n, l / g, k, h / j, q, x. Finals: i, u, ü, er / a, ia, ua / o, uo / e, ie, üe / ai, uai / ei, uei (ui) / ao, iao."
        },
        "syllables": [
          "b", "p", "m", "f", "d", "t", "n", "l", "g", "k", "h", "j", "q", "x",
          "i", "u", "ü", "er", "a", "ia", "ua", "o", "uo", "e", "ie", "üe",
          "ai", "uai", "ei", "uei (ui)", "ao", "iao"
        ]
      },
      {
        "number": 2,
        "title": { "hanzi": "汉语的声调 (四声)", "english": "Tones (Four Tones)" },
        "explanation": {
          "hanzi": "汉语的基本声调有四个,分别是第一声(55)、第二声(35)、第三声(214)和第四声(51)。声调有区别意义的作用。例如:mā(妈)mother、má(麻)fibrous crops、mǎ(马)horse、mà(骂)to scold。",
          "english": "Mandarin has four basic tones: 1st tone (high level, 55), 2nd tone (rising, 35), 3rd tone (falling-rising, 214), 4th tone (falling, 51). Tone changes meaning — mā (mother), má (fibrous crops), mǎ (horse), mà (to scold)."
        },
        "syllables": [
          "ā", "á", "ǎ", "à",
          "ō", "ó", "ǒ", "ò",
          "ē", "é", "ě", "è",
          "ī", "í", "ǐ", "ì",
          "ū", "ú", "ǔ", "ù",
          "ǖ", "ǘ", "ǚ", "ǜ"
        ]
      },
      {
        "number": 3,
        "title": { "hanzi": "汉语的音节", "english": "Chinese Syllables" },
        "explanation": {
          "hanzi": "汉语的音节一般由声母、韵母、声调三部分组成。一般来说,一个汉字对应一个音节。汉语的一个音节可以没有声母,但是一定要有韵母和声调。注意:i 和 ü 自成音节时,韵母前增加 y,ü 上的两点去掉;u 自成音节时,韵母前增加 w。",
          "english": "A Chinese syllable usually consists of an initial, a final, and a tone. Generally each Chinese character corresponds to one syllable. A syllable may have no initial but must have a final and a tone. Note: when i or ü stands alone, y is added (and ü loses its umlaut); when u stands alone, w is added."
        },
        "syllables": [
          "yī", "wǔ", "yú", "ěr", "bǐ", "māo", "dǎo", "huā", "jī", "qī", "xié", "xuě"
        ]
      },
      {
        "number": 4,
        "title": {
          "hanzi": "两个三声音节的连读变调",
          "english": "Tone Sandhi: 3rd tone + 3rd tone"
        },
        "explanation": {
          "hanzi": "当两个第三声音节连读时,第一个音节变为第二声(3+3 变为 2+3)。例如\"nǐ\"+\"hǎo\"变为\"ní hǎo\"。注音时,要标原调。",
          "english": "When two 3rd-tone syllables come together, the first turns into a 2nd tone — 3+3 → 2+3. For example nǐ + hǎo is pronounced ní hǎo, although the written form keeps the original tone."
        },
        "syllables": [
          "nǐ hǎo", "kěyǐ", "fǔdǎo", "xiǎojiě",
          "kǒuyǔ", "yǔfǎ", "Fǎyǔ", "tǎo hǎo",
          "liǎojiě", "yǒuhǎo", "yǔsǎn", "shǒubiǎo"
        ]
      }
    ]
