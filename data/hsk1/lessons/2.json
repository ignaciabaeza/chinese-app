          "yún", "xīng", "yuán", "rén", "chuán", "chuáng", "chī", "rè"
        ]
      },
      {
        "number": 2,
        "title": { "hanzi": "汉语的轻声", "english": "The Neutral Tone" },
        "explanation": {
          "hanzi": "汉语中除了四声以外,还有一个读得又短又轻的声调,叫作\"轻声\"。例如:妈妈 (māma)、爷爷 (yéye)、奶奶 (nǎinai)、爸爸 (bàba)。",
          "english": "In addition to the four tones, Mandarin has a short, light tone called the \"neutral tone\". Examples: māma (mom), yéye (grandpa), nǎinai (grandma), bàba (dad)."
        },
        "syllables": [
          "zhuōzi", "fángzi", "yǐzi", "guìzi",
          "tāmen", "rénmen", "wǒmen", "dìdi",
          "yīfu", "érzi", "xǐhuan", "rènshi",
          "xiānsheng", "péngyou", "wǎnshang", "piàoliang"
        ]
      },
      {
        "number": 3,
        "title": {
          "hanzi": "拼音规则 (1):标调法和省写",
          "english": "Rules of Pinyin (1): Tone Marking and Abbreviation"
        },
        "explanation": {
          "hanzi": "(1) 标调法:声调必须标在元音字母上。当韵母含有两个或更多元音字母时,调号标在开口度较大的元音上(顺序:a、o、e、i、u、ü);但 iu 是 iou 的省略形式,声调标在 u 上。轻声不标调。(2) 省写:iou、uei、uen 前面加声母时,写成 iu、ui、un。",
          "english": "(1) Tone marks go on the vowel. With multiple vowels, mark the one with the widest mouth (order: a, o, e, i, u, ü). Exception: iu is the abbreviation of iou and the mark goes on u. Neutral-tone syllables aren't marked. (2) When iou, uei, uen follow an initial, they're written iu, ui, un (e.g., niu, gui, lun)."
        },
        "syllables": [
          "xuéxiào", "bāng máng", "lánqiú", "nǚ'ér",
          "yóu yǒng", "shǒubiǎo", "zhōngyú", "gōngsī",
          "shíjiān", "shēntǐ", "kǎoshì", "guójiā",
          "bàozhǐ", "hǎochī", "xièxie", "kèqi",
          "xiūxi", "shuì jiào", "lúnchuán", "niúnǎi",
          "píjiǔ", "ánggui", "liúyán", "kāi huì",
          "tǎolùn", "zúqiú", "Lúndūn", "shīrùn",
          "cánkuì", "shuǐguǒ", "táozuì", "shùnlì"
        ]
      }
