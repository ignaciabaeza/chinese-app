  "pinyinSection": {
    "drills": [
      {
        "number": 1,
        "title": {
          "hanzi": "声母和韵母（二）",
          "english": "Initials and finals (2)"
        },
        "explanation": {
          "hanzi": "这一课学习剩下的十个声母：j q x、zh ch sh r、z c s，还有带鼻音的韵母和更多复韵母。q、ch、c 都是送气音，发音时要送出较强的气流。",
          "english": "This lesson completes the initials with three families: j q x, zh ch sh r, and z c s. In each family the middle one (q, ch, c) is aspirated — say it with a strong puff of air, just like p, t, k. The finals here are the nasal ones: -n is made with the tongue tip pressed up behind the teeth (like \"n\" in \"ban\"), -ng with the back of the tongue raised and the mouth left open (like \"ng\" in \"sung\"). Many words differ only in -n vs -ng, so exaggerate the difference at first."
        },
        "syllables": [
          "j  q  x",
          "zh  ch  sh  r",
          "z  c  s",
          "an  en  ang  eng  ong",
          "ia  ie  iao  iu  ian  in  iang  ing  iong",
          "ua  uo  uai  ui  uan  un  uang",
          "üe  üan  ün",
          "jiā  qiē  xiǎo  zhōng  chá  shān  rè  zài  cài  sān"
        ],
        "subRules": [
          {
            "rule": {
              "hanzi": "j q x：舌面音。舌尖放在下齿后面，嘴角向两边拉开。后面只能跟 i 或 ü。",
              "english": "j, q, x: the tongue tip rests behind the lower teeth and the lips are spread, as in a smile. They only combine with finals that start with i or ü."
            },
            "examples": [
              { "pinyin": "jiā", "english": "home (家)" },
              { "pinyin": "qī", "english": "seven (七)" },
              { "pinyin": "xiè", "english": "to thank (谢)" },
              { "pinyin": "jiàn", "english": "to see (见)" }
            ]
          },
          {
            "rule": {
              "hanzi": "zh ch sh r：翘舌音。舌尖向上卷起，靠近上齿后面较高的地方。",
              "english": "zh, ch, sh, r: curl the tongue tip up and back towards the roof of the mouth. r sounds somewhere between English \"r\" and the \"s\" in \"pleasure\"."
            },
            "examples": [
              { "pinyin": "zhōng", "english": "middle (中)" },
              { "pinyin": "chá", "english": "tea (茶)" },
              { "pinyin": "shān", "english": "mountain (山)" },
              { "pinyin": "rén", "english": "person (人)" }
            ]
          },
          {
            "rule": {
              "hanzi": "z c s：平舌音。舌尖平放，碰上齿背。z 像 \"kids\" 里的 ds，c 像 \"cats\" 里的 ts。",
              "english": "z, c, s: keep the tongue flat with its tip against the back of the upper teeth. z sounds like \"ds\" in \"kids\", c like \"ts\" in \"cats\" (with a puff of air), s like English s."
            },
            "examples": [
              { "pinyin": "zài", "english": "again (再)" },
              { "pinyin": "cài", "english": "dish (菜)" },
              { "pinyin": "sān", "english": "three (三)" },
              { "pinyin": "kèqi", "english": "polite (客气)" }
            ]
          },
          {
            "rule": {
              "hanzi": "前鼻音 -n 和后鼻音 -ng。",
              "english": "Front nasal -n vs. back nasal -ng."
            },
            "examples": [
              { "pinyin": "fàn / fàng", "english": "meal / to put" },
              { "pinyin": "rén / réng", "english": "person / still" },
              { "pinyin": "xīn / xīng", "english": "new / star" },
              { "pinyin": "guān / guāng", "english": "to close / light" }
            ]
          }
        ]
      },
      {
        "number": 2,
        "title": {
          "hanzi": "轻声",
          "english": "The neutral tone"
        },
        "explanation": {
          "hanzi": "有的音节在词语里读得又轻又短，没有原来的声调，叫“轻声”。轻声在拼音上不标声调符号。轻声的高低由前面一个音节决定：在一、二、四声后面比较低，在三声后面比较高。",
          "english": "In many words the last syllable loses its tone and is said lightly and quickly. This is the neutral tone, and in pinyin it simply has no tone mark: xièxie, nǐmen, kèqi. Its pitch depends on the syllable before it: after a 1st, 2nd or 4th tone it is short and low; after a 3rd tone it is short and a little higher, because the voice is rising out of the dip. Keep neutral syllables short — about half the length of a normal syllable."
        },
        "syllables": [
          "xièxie",
          "nǐmen",
          "kèqi",
          "māma",
          "bàba",
          "péngyou",
          "míngzi",
          "duìbuqǐ"
        ],
        "subRules": [
          {
            "rule": { "hanzi": "一声 + 轻声", "english": "1st tone + neutral tone" },
            "examples": [
              { "pinyin": "māma", "english": "mum" },
              { "pinyin": "gēge", "english": "older brother" },
              { "pinyin": "tāmen", "english": "they" }
            ]
          },
          {
            "rule": { "hanzi": "二声 + 轻声", "english": "2nd tone + neutral tone" },
            "examples": [
              { "pinyin": "péngyou", "english": "friend" },
              { "pinyin": "míngzi", "english": "name" },
              { "pinyin": "shénme", "english": "what" }
            ]
          },
          {
            "rule": { "hanzi": "三声 + 轻声", "english": "3rd tone + neutral tone" },
            "examples": [
              { "pinyin": "nǐmen", "english": "you (plural)" },
              { "pinyin": "wǒmen", "english": "we" },
              { "pinyin": "jiějie", "english": "older sister" }
            ]
          },
          {
            "rule": { "hanzi": "四声 + 轻声", "english": "4th tone + neutral tone" },
            "examples": [
              { "pinyin": "xièxie", "english": "thank you" },
              { "pinyin": "kèqi", "english": "polite" },
              { "pinyin": "bàba", "english": "dad" }
            ]
          }
        ]
      },
      {
        "number": 3,
        "title": {
          "hanzi": "声调符号的位置和 iu、ui、un 的写法",
          "english": "Where the tone mark goes, and the spellings iu, ui, un"
        },
        "explanation": {
          "hanzi": "声调符号标在主要元音上。有 a 标 a；没有 a 就标 o 或 e；iu 和 ui 标在后面的字母上。i 上标声调时，去掉 i 上的点。另外，iou、uei、uen 前面有声母时，写成 iu、ui、un。",
          "english": "The tone mark goes on the main vowel, and you can find it with a simple order of priority: if there is an a, mark the a (hǎo, guān); if not, mark the o or e (duō, xiè); in the pairs iu and ui, mark whichever comes second (liù, duì). When i carries a mark, its dot disappears (nǐ, not nǐ with a dot). Pinyin also shortens three finals when they follow an initial: iou → iu, uei → ui, uen → un. The full vowel is still faintly there in speech — liù sounds like \"l-yoh\" — but it is never written."
        },
        "syllables": [
          "a > o / e > i / u",
          "hǎo  guān  xiào",
          "duō  xiè  méi",
          "liù  jiǔ  duì  guì",
          "l + iou → liù",
          "d + uei → duì",
          "ch + uen → chūn"
        ],
        "subRules": [
          {
            "rule": {
              "hanzi": "iou → iu：有声母时写成 iu。",
              "english": "iou → iu after an initial (without an initial it is written you)."
            },
            "examples": [
              { "pinyin": "liù", "english": "six" },
              { "pinyin": "jiǔ", "english": "nine" },
              { "pinyin": "qiú", "english": "ball" },
              { "pinyin": "yǒu", "english": "to have (no initial)" }
            ]
          },
          {
            "rule": {
              "hanzi": "uei → ui：有声母时写成 ui。",
              "english": "uei → ui after an initial (without an initial it is written wei)."
            },
            "examples": [
              { "pinyin": "duì", "english": "right" },
              { "pinyin": "guì", "english": "expensive" },
              { "pinyin": "shuí", "english": "who" },
              { "pinyin": "wèi", "english": "hello? (on the phone; no initial)" }
            ]
          },
          {
            "rule": {
              "hanzi": "uen → un：有声母时写成 un。",
              "english": "uen → un after an initial (without an initial it is written wen)."
            },
            "examples": [
              { "pinyin": "chūn", "english": "spring" },
              { "pinyin": "lùn", "english": "to discuss" },
              { "pinyin": "dūn", "english": "to squat" },
              { "pinyin": "wèn", "english": "to ask (no initial)" }
            ]
          }
        ]
      }
    ]
  },
