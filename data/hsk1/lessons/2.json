        "number": 1,
        "title": {
          "hanzi": "汉语拼音的声母和韵母 (2)",
          "english": "Initials and Finals of Chinese Pinyin (2)"
        },
        "explanation": {
          "hanzi": "声母 (Initials): zh ch sh r / z c s。韵母 (Finals): ou iou (iu) / an ian uan üan / en in uen (un) ün / ang iang uang / eng ing ueng / ong iong。",
          "english": "Initials introduced in this lesson: zh, ch, sh, r / z, c, s. Finals: ou, iou (iu) / an, ian, uan, üan / en, in, uen (un), ün / ang, iang, uang / eng, ing, ueng / ong, iong."
        },
        "syllables": [
          "zh", "ch", "sh", "r", "z", "c", "s",
          "ou", "iou (iu)", "an", "ian", "uan", "üan",
          "en", "in", "uen (un)", "ün",
          "ang", "iang", "uang", "eng", "ing", "ueng", "ong", "iong",
