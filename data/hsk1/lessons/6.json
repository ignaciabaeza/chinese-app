  "pinyinSection": {
    "drills": [
      {
        "number": 1,
        "title": {
          "hanzi": "三声变调：三声 + 三声",
          "english": "Third-tone sandhi: two third tones in a row"
        },
        "explanation": {
          "hanzi": "两个三声音节连在一起时，前一个三声读成二声，后一个不变。拼音上仍然写三声符号。",
          "english": "When two third-tone syllables come together, the first one is said with a rising second tone; the second keeps its third tone. Pinyin still prints both with the third-tone mark — you change it only when speaking. So 你好 nǐ hǎo is said \"ní hǎo\"."
        },
        "syllables": [
          "nǐ hǎo → ní hǎo",
          "hěn hǎo → hén hǎo",
          "wǒ xiě → wó xiě",
          "kěyǐ → kéyǐ",
          "shuǐguǒ → shuíguǒ",
          "yǔfǎ → yúfǎ"
        ]
      },
      {
        "number": 2,
        "title": {
          "hanzi": "半三声",
          "english": "The half third tone"
        },
        "explanation": {
          "hanzi": "三声在一声、二声、四声前面时，一般只读前半部分（低降），不再升上去，叫“半三声”。",
          "english": "Before a first, second or fourth tone, a third tone is usually cut short: it only dips low and doesn't rise again. This \"half third tone\" is what you hear most of the time in real speech."
        },
        "syllables": [
          "hǎochī",
          "lǎoshī",
          "Měiguó",
          "nǚ'ér",
          "hěn dà",
          "xiě zì"
        ]
      }
    ]
  },
