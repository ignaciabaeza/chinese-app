  "notes": [
    {
      "id": "hsk1_6_g_hui",
      "number": 1,
      "title": {
        "hanzi": "能愿动词“会”",
        "english": "The Modal Verb \"会\""
      },
      "explanation": {
        "hanzi": "“会”放在动词前面，表示通过学习掌握了某种技能，比如说一种语言、写汉字、做菜。否定形式是“不会”。问别人可以用“会……吗？”，回答可以只说“会”或“不会”。",
        "english": "Put \"会\" in front of a verb to say that someone has learned how to do something: speak a language, write characters, cook a dish. The negative is \"不会\" (bú huì). To ask, use \"会……吗？\"; a short answer can simply be \"会\" (yes) or \"不会\" (no)."
      },
      "examples": [
        {
          "hanzi": "我会说汉语。",
          "pinyin": "Wǒ huì shuō Hànyǔ.",
          "english": "I can speak Chinese."
        },
        {
          "hanzi": "她妈妈会做中国菜。",
          "pinyin": "Tā māma huì zuò Zhōngguó cài.",
          "english": "Her mother can cook Chinese food."
        },
        {
          "hanzi": "你会写汉字吗？",
          "pinyin": "Nǐ huì xiě Hànzì ma?",
          "english": "Can you write Chinese characters?"
        },
        {
          "hanzi": "马克不会读汉字。",
          "pinyin": "Mǎkè bú huì dú Hànzì.",
          "english": "Mark can't read Chinese characters."
        }
      ],
      "patternTable": {
        "columns": [
          "Subject",
          "会 / 不会",
          "Verb",
          "Object"
        ],
        "rows": [
          [
            "我",
            "会",
            "说",
            "汉语。"
          ],
          [
            "王明",
            "不会",
            "做",
            "美国菜。"
          ],
          [
            "你",
            "会",
            "写",
            "汉字吗？"
          ]
        ]
      }
    },
    {
      "id": "hsk1_6_g_adj_predicate",
      "number": 2,
      "title": {
        "hanzi": "形容词谓语句",
        "english": "Sentences with an Adjectival Predicate"
      },
      "explanation": {
        "hanzi": "汉语的形容词可以直接做谓语，不用“是”。肯定句里常常在形容词前加“很”，这时“很”的意思不一定是“非常”。否定的时候用“不”。",
        "english": "In Chinese an adjective can be the predicate on its own — do not put \"是\" in front of it. In a positive statement we usually add \"很\" before the adjective; here \"很\" is often just a link and doesn't always mean \"very\". To make it negative, use \"不\" instead: 不好吃."
      },
      "examples": [
        {
          "hanzi": "中国菜很好吃。",
          "pinyin": "Zhōngguó cài hěn hǎochī.",
          "english": "Chinese food is delicious."
        },
        {
          "hanzi": "我妈妈很好。",
          "pinyin": "Wǒ māma hěn hǎo.",
          "english": "My mom is well."
        },
        {
          "hanzi": "刘老师的字很好。",
          "pinyin": "Liú lǎoshī de zì hěn hǎo.",
          "english": "Ms. Liu's handwriting is very good."
        },
        {
          "hanzi": "马克做的菜不好吃。",
          "pinyin": "Mǎkè zuò de cài bù hǎochī.",
          "english": "The food Mark cooks isn't tasty."
        }
      ],
      "patternTable": {
        "columns": [
          "Subject",
          "很 / 不",
          "Adjective"
        ],
        "rows": [
          [
            "中国菜",
            "很",
            "好吃。"
          ],
          [
            "你妈妈",
            "很",
            "好。"
          ],
          [
            "马克做的菜",
            "不",
            "好吃。"
          ]
        ]
      }
    },
    {
      "id": "hsk1_6_g_zenme",
      "number": 3,
      "title": {
        "hanzi": "疑问代词“怎么”",
        "english": "The Interrogative Pronoun \"怎么\""
      },
      "explanation": {
        "hanzi": "“怎么”放在动词前面，用来询问做某事的方式，结构是“怎么 + 动词”。例如问一个字怎么读、怎么写，或者一个菜怎么做。",
        "english": "\"怎么\" goes right before a verb to ask about the way something is done: 怎么 + verb, \"how do you…?\". It's handy for asking how a character is read or written, or how a dish is made."
      },
      "examples": [
        {
          "hanzi": "“读”字怎么写？",
          "pinyin": "\"Dú\" zì zěnme xiě?",
          "english": "How do you write the character \"读\"?"
        },
        {
          "hanzi": "你的名字怎么写？",
          "pinyin": "Nǐ de míngzi zěnme xiě?",
          "english": "How do you write your name?"
        },
        {
          "hanzi": "中国菜怎么做？",
          "pinyin": "Zhōngguó cài zěnme zuò?",
          "english": "How do you cook Chinese food?"
        },
        {
          "hanzi": "“对不起”怎么写？",
          "pinyin": "\"Duìbuqǐ\" zěnme xiě?",
          "english": "How do you write \"duibuqi\" (sorry)?"
        }
      ],
