  "pinyinSection": {
    "drills": [
      {
        "number": 1,
        "title": {
          "hanzi": "发音辨析:声母j、q、x和z、c、s",
          "english": "Differentiation: pronunciation of the initials j, q, x and z, c, s"
        },
        "explanation": {
          "hanzi": "j、q、x是舌面音。z、c、s是舌尖前音。",
          "english": "j, q and x are coronals (tongue surface against hard palate). z, c and s are dentals (tongue tip near upper teeth)."
        },
        "syllables": [
          "xiūxi", "jījí", "jīqì", "xiǎoqū",
          "xīngqī", "xiāngjiāo", "xìngqù", "jìxù",
          "xǐ zǎo", "dǎsǎo", "sān cì", "zìjǐ",
          "zuótiān", "zǎoshang", "cāochǎng", "Hànzì"
        ]
      },
      {
        "number": 2,
        "title": {
          "hanzi": "发音辨析:韵母i、u、ü",
          "english": "Differentiation: pronunciation of the finals i, u, ü"
        },
        "explanation": {
          "hanzi": "i和ü发音位置相同,但嘴唇形状不同;u和ü都是圆唇音,但ü舌位在前。",
          "english": "i and ü share the same tongue position but differ in lip shape (ü rounds the lips). u and ü both round the lips, but ü positions the tongue forward."
        }
      },
      {
        "number": 3,
        "title": { "hanzi": "\"不\"的变调", "english": "Tone Sandhi of \"不\"" },
        "subRules": [
          {
            "rule": {
              "hanzi": "\"不\"在第一、二、三声音节前不变调",
              "english": "When \"不\" is followed by a syllable in the first, second or third tone, its tone doesn't change."
            },
            "examples": [
              { "pinyin": "bù chī",  "english": "to not eat" },
              { "pinyin": "bù xíng", "english": "not OK" },
              { "pinyin": "bù hǎo",  "english": "not good" },
              { "pinyin": "bù hē",   "english": "to not drink" },
              { "pinyin": "bù néng", "english": "can't" },
              { "pinyin": "bù xiǎng","english": "don't want" }
            ]
          },
          {
            "rule": {
              "hanzi": "\"不\"在第四声音节前变成第二声",
              "english": "When \"不\" is followed by a syllable in the fourth tone, it changes into the second tone."
            },
            "examples": [
              { "pinyin": "bú huì", "english": "to be unable to" },
              { "pinyin": "bú shì", "english": "to be not" },
              { "pinyin": "bú kàn", "english": "to not look" }
            ]
          }
        ]
      },
      {
        "number": 4,
        "title": {
          "hanzi": "拼音规则(2):单韵母ü和ü开头的韵母跟j、q、x相拼的规则",
          "english": "Rules of Pinyin (2): ü or finals led by ü with j, q, x"
        },
        "explanation": {
          "hanzi": "ü和ü开头的韵母跟声母j、q、x相拼的时候,ü上两点要省略,如写成ju、qu、xu;但是跟声母l、n相拼的时候,仍然要写成lü、nü。",
          "english": "When ü or a final beginning with ü follows j, q or x, the two dots are dropped (ju, qu, xu). After l or n, they are kept (lü, nü)."
        },
        "syllables": [
          "ü", "üe", "üan", "ün",
          "ju", "jue", "juan", "jun",
          "qu", "que", "quan", "qun",
          "xu", "xue", "xuan", "xun"
        ]
      }
    ]
  },
