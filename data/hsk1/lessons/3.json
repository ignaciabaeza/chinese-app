  "notes": [
    {
      "id": "hsk1_3_g_shenme",
      "number": 1,
      "title": { "hanzi": "疑问代词\"什么\"", "english": "The Interrogative Pronoun \"什么\"" },
      "explanation": {
        "hanzi": "疑问代词\"什么\"表示疑问,用在疑问句中可直接做宾语,或者与后接名词性成分一起做宾语。例如:",
        "english": "The interrogative pronoun \"什么\" is used in interrogative sentences, serving as the object by itself or together with a nominal element following it. For example:"
      },
      "examples": [
        { "hanzi": "你叫什么名字?", "pinyin": "Nǐ jiào shénme míngzi?", "english": "What's your name?" },
        { "hanzi": "这是什么?",     "pinyin": "Zhè shì shénme?",        "english": "What is this?" },
        { "hanzi": "这是什么书?",   "pinyin": "Zhè shì shénme shū?",    "english": "What book is this?" }
      ]
    },
    {
      "id": "hsk1_3_g_shi",
      "number": 2,
      "title": { "hanzi": "\"是\"字句", "english": "The \"是\" Sentence" },
      "explanation": {
        "hanzi": "\"是\"字句是由\"是\"构成的判断句,用于表达人或事物等于什么或者属于什么。其否定形式是在\"是\"前加上否定副词\"不\"。例如:",
        "english": "A \"是\" sentence is a determinative sentence with \"是\", indicating what somebody or something equals or belongs to. The negative sentence is formed by adding the negative adverb \"不\" before \"是\". For example:"
      },
      "patternTable": {
        "columns": ["Subject", "(不)是", "Noun/Noun Phrase"],
        "rows": [
          ["李月", "是",   "老师。"],
          ["我",   "是",   "美国人。"],
          ["我",   "不是", "老师。"]
        ]
      }
    },
    {
      "id": "hsk1_3_g_ma",
      "number": 3,
      "title": { "hanzi": "用\"吗\"的疑问句", "english": "Interrogative Sentences with \"吗\"" },
      "explanation": {
        "hanzi": "疑问助词\"吗\"表示疑问语气,用在陈述句句尾构成疑问句。例如:",
        "english": "The particle \"吗\" indicates an interrogative mood. When \"吗\" is added at the end of a declarative sentence, the declarative sentence turns into a question. For example:"
      },
      "patternTable": {
        "columns": ["Subject", "Verb", "Noun/Noun Phrase", "吗?"],
        "rows": [
          ["你", "是", "美国人", "吗?"],
          ["你", "是", "中国人", "吗?"],
          ["你", "是", "老师",   "吗?"]
        ]
      }
    }
  ],
