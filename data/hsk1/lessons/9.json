  "pinyinSection": {
    "drills": [
      {
        "number": 1,
        "title": {
          "hanzi": "儿化",
          "english": "The retroflex -r (erhua)"
        },
        "explanation": {
          "hanzi": "“儿”可以和前面的字读成一个音节，叫“儿化”。写汉字时加“儿”，写拼音时只加 r。北方人说话常常用儿化。",
          "english": "儿 can merge with the syllable before it into a single syllable: the tongue curls back at the end of the sound. This is called erhua. In characters you add 儿; in pinyin you add only -r (哪儿 = nǎr, not nǎ ér). Erhua is very common in Beijing and northern speech."
        },
        "syllables": [
          "nǎr",
          "nàr",
          "zhèr",
          "yìdiǎnr",
          "huār",
          "xiǎoháir"
        ],
        "subRules": [
          {
            "rule": {
              "hanzi": "大多数音节直接加 r",
              "english": "Most syllables: just add the curl at the end"
            },
            "examples": [
              {
                "pinyin": "nǎ → nǎr",
                "english": "where"
              },
              {
                "pinyin": "nà → nàr",
                "english": "there"
              },
              {
                "pinyin": "zhè → zhèr",
                "english": "here"
              },
              {
                "pinyin": "huā → huār",
                "english": "flower"
              }
            ]
          },
          {
            "rule": {
              "hanzi": "以 -n 或 -i 结尾的音节：-n、-i 不发音",
              "english": "Syllables ending in -n or -i: the -n / -i is dropped in speech, then the curl is added"
            },
            "examples": [
              {
                "pinyin": "yìdiǎn → yìdiǎnr",
                "english": "a little (preview)"
              },
              {
                "pinyin": "xiǎohái → xiǎoháir",
                "english": "child"
              },
              {
                "pinyin": "wán → wánr",
                "english": "to play"
              }
            ]
          }
        ]
