  "notes": [
    {
      "id": "hsk1_9_g_zai_verb",
      "number": 1,
      "title": {
        "hanzi": "动词“在”",
        "english": "The verb 在 (to be at / in)"
      },
      "explanation": {
        "hanzi": "“在”可以做动词，说人或东西在什么地方：人/东西 + 在 + 地方。否定形式是“不在”（bú zài）。",
        "english": "As a verb, 在 tells you where somebody or something is: person/thing + 在 + place. No other verb is needed — 在 already means \"is at\". The negative is 不在 (pronounced bú zài)."
      },
      "examples": [
        {
          "hanzi": "我的猫在椅子下面。",
          "pinyin": "Wǒ de māo zài yǐzi xiàmiàn.",
          "english": "My cat is under the chair."
        },
        {
          "hanzi": "刘老师不在学校。",
          "pinyin": "Liú lǎoshī bú zài xuéxiào.",
          "english": "Ms. Liu isn't at school."
        },
        {
          "hanzi": "马克在家吗？",
          "pinyin": "Mǎkè zài jiā ma?",
          "english": "Is Mark at home?"
        },
        {
          "hanzi": "你的书在那儿。",
          "pinyin": "Nǐ de shū zài nàr.",
          "english": "Your book is over there."
        }
      ],
      "patternTable": {
        "columns": [
          "人 / 东西",
          "在 / 不在",
          "地方"
        ],
        "rows": [
          [
            "我的猫",
            "在",
            "椅子下面"
          ],
          [
            "王明的爸爸",
            "不在",
            "家"
          ],
          [
            "你的杯子",
            "在",
            "那儿"
          ]
        ]
      }
    },
    {
      "id": "hsk1_9_g_naer",
      "number": 2,
      "title": {
        "hanzi": "疑问代词“哪儿”",
        "english": "The question word 哪儿 (where)"
      },
      "explanation": {
        "hanzi": "“哪儿”用来问地方。问句的词序和回答一样，只要把地方换成“哪儿”。",
        "english": "哪儿 asks \"where\". Chinese questions keep the same word order as the answer: just put 哪儿 where the place would go. 你在哪儿？ → 我在家。 Don't confuse it with 那儿 (nàr, \"there\") — only the tone is different."
      },
      "examples": [
        {
          "hanzi": "你的狗在哪儿？",
          "pinyin": "Nǐ de gǒu zài nǎr?",
          "english": "Where is your dog?"
        },
        {
          "hanzi": "下午你想去哪儿？",
          "pinyin": "Xiàwǔ nǐ xiǎng qù nǎr?",
          "english": "Where do you want to go this afternoon?"
        },
        {
          "hanzi": "你家在哪儿？",
          "pinyin": "Nǐ jiā zài nǎr?",
          "english": "Where is your home?"
        },
        {
          "hanzi": "安娜在哪儿？——她在那儿。",
          "pinyin": "Ānnà zài nǎr? —— Tā zài nàr.",
          "english": "Where is Anna? — She's over there."
        }
      ]
    },
    {
      "id": "hsk1_9_g_zai_prep",
      "number": 3,
      "title": {
        "hanzi": "介词“在”",
        "english": "The preposition 在 (at / in + action)"
      },
      "explanation": {
        "hanzi": "“在 + 地方”放在动词前面，说在哪儿做某事：主语 + 在 + 地方 + 动词（+ 宾语）。注意：地方要放在动词前面，不能放在后面。",
        "english": "在 + place can also come before a verb to say where an action happens: subject + 在 + place + verb (+ object). Unlike English, the place goes before the verb, never at the end: 他在医院工作 (literally \"he at hospital works\")."
      },
      "examples": [
        {
          "hanzi": "他儿子在医院工作。",
          "pinyin": "Tā érzi zài yīyuàn gōngzuò.",
          "english": "His son works at a hospital."
        },
        {
          "hanzi": "我在学校看书。",
          "pinyin": "Wǒ zài xuéxiào kàn shū.",
          "english": "I read at school."
        },
        {
          "hanzi": "马克在家做中国菜。",
          "pinyin": "Mǎkè zài jiā zuò Zhōngguó cài.",
          "english": "Mark cooks Chinese food at home."
        },
        {
          "hanzi": "你爸爸在哪儿工作？",
          "pinyin": "Nǐ bàba zài nǎr gōngzuò?",
          "english": "Where does your father work?"
        }
      ],
      "patternTable": {
        "columns": [
          "主语",
          "在",
          "地方",
          "动词 (+ 宾语)"
        ],
        "rows": [
          [
            "他儿子",
