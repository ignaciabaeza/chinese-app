  "pinyinSection": {
    "drills": [
      {
        "number": 1,
        "title": {
          "hanzi": "“一”的变调",
          "english": "Tone changes of 一"
        },
        "explanation": {
          "hanzi": "“一”本来是一声 yī。单独读、数数、在词的最后或者表示序数（如日期、星期）时读 yī；在四声前面读二声 yí；在一声、二声、三声前面读四声 yì。",
          "english": "\"一\" is first tone (yī) by itself. It keeps yī when counted, at the end of a word, or in ordinals such as dates and weekdays. Before a fourth tone it becomes yí; before a first, second or third tone it becomes yì. Pinyin in this course prints the changed tone."
        },
        "subRules": [
          {
            "rule": {
              "hanzi": "读一声 yī",
              "english": "Stays yī: alone, counting, word-final, dates and ordinals"
            },
            "examples": [
              {
                "pinyin": "yī",
                "english": "one"
              },
              {
                "pinyin": "shíyī",
                "english": "eleven"
              },
              {
                "pinyin": "yī yuè yī hào",
                "english": "January 1st"
              },
              {
                "pinyin": "xīngqīyī",
                "english": "Monday"
              }
            ]
          },
          {
            "rule": {
              "hanzi": "四声前读二声 yí",
              "english": "Becomes yí before a fourth tone"
            },
            "examples": [
              {
                "pinyin": "yí ge",
                "english": "one (of something)"
              },
              {
                "pinyin": "yí kuài",
                "english": "one yuan"
              },
              {
                "pinyin": "yíyàng",
                "english": "the same"
              }
            ]
          },
          {
            "rule": {
              "hanzi": "一声、二声、三声前读四声 yì",
              "english": "Becomes yì before a first, second or third tone"
            },
            "examples": [
              {
                "pinyin": "yì tiān",
                "english": "one day"
              },
              {
                "pinyin": "yì nián",
                "english": "one year"
              },
              {
                "pinyin": "yìqǐ",
                "english": "together"
              },
              {
                "pinyin": "yìbǎi",
                "english": "one hundred"
              }
            ]
          }
        ]
      }
    ]
  },
