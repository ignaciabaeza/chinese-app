  "notes": [
    {
      "id": "hsk1_7_g_dates",
      "number": 1,
      "title": {
        "hanzi": "日期的表达",
        "english": "Expressing Dates"
      },
      "explanation": {
        "hanzi": "汉语说日期的顺序是从大到小：年 → 月 → 号（日）→ 星期。年份一个数字一个数字地读，比如2026年读作 èr líng èr liù nián。口语里常说“号”，书面上常写“日”。星期一到星期六用数字，星期天也可以说星期日。问日期用“几月几号”，问星期用“星期几”。",
        "english": "Chinese gives dates from the biggest unit to the smallest: year → month → day → day of the week. Years are read digit by digit: 2026年 is \"èr líng èr liù nián\". In speech the day is usually 号 (hào); in writing you'll also see 日 (rì). Monday to Saturday are 星期一 to 星期六; Sunday is 星期天 (or 星期日). Ask the date with 几月几号 and the weekday with 星期几."
      },
      "examples": [
        {
          "hanzi": "今天10月21号。",
          "pinyin": "Jīntiān shí yuè èrshíyī hào.",
          "english": "Today is October 21st."
        },
        {
          "hanzi": "2026年9月1号，星期二。",
          "pinyin": "Èr líng èr liù nián jiǔ yuè yī hào, xīngqī'èr.",
          "english": "Tuesday, September 1st, 2026."
        },
        {
          "hanzi": "明天几月几号？",
          "pinyin": "Míngtiān jǐ yuè jǐ hào?",
          "english": "What's the date tomorrow?"
        },
        {
          "hanzi": "昨天星期几？",
          "pinyin": "Zuótiān xīngqī jǐ?",
          "english": "What day was it yesterday?"
        }
      ],
      "patternTable": {
        "columns": [
          "Year 年",
          "Month 月",
          "Day 号",
          "Weekday 星期"
        ],
        "rows": [
          [
            "2026年",
            "10月",
            "21号",
            "星期三"
          ],
          [
            "2026年",
            "9月",
            "1号",
            "星期二"
          ],
          [
            "",
            "几月",
            "几号",
            "星期几？"
          ]
        ]
      }
    },
    {
      "id": "hsk1_7_g_nominal_predicate",
      "number": 2,
      "title": {
        "hanzi": "名词谓语句",
        "english": "Sentences with a Nominal Predicate"
      },
      "explanation": {
        "hanzi": "说日期、星期、年龄的时候，名词或者名词短语可以直接做谓语，一般不用“是”，例如“今天3月5号”。但是否定的时候要用“不是”。",
        "english": "When you give a date, a weekday or an age, a noun phrase can be the predicate by itself — you usually leave out \"是\": 今天3月5号. In the negative, though, you must say \"不是\": 今天不是星期天."
      },
      "examples": [
        {
          "hanzi": "今天3月5号。",
          "pinyin": "Jīntiān sān yuè wǔ hào.",
          "english": "Today is March 5th."
        },
        {
          "hanzi": "明天星期六。",
          "pinyin": "Míngtiān xīngqīliù.",
          "english": "Tomorrow is Saturday."
        },
        {
          "hanzi": "王明今年20岁。",
          "pinyin": "Wáng Míng jīnnián èrshí suì.",
          "english": "Wang Ming is 20 this year."
        },
        {
          "hanzi": "今天不是星期天。",
          "pinyin": "Jīntiān bú shì xīngqītiān.",
          "english": "Today isn't Sunday."
        }
      ],
      "patternTable": {
        "columns": [
          "Subject",
          "Noun phrase (predicate)"
        ],
        "rows": [
          [
            "今天",
            "3月5号。"
          ],
          [
            "明天",
            "星期六。"
          ],
          [
            "昨天",
            "不是星期一。"
          ]
        ]
      }
    },
    {
      "id": "hsk1_7_g_qu_place_verb",
      "number": 3,
      "title": {
        "hanzi": "连动句：去 + 地方 + 做什么",
        "english": "Serial Verb Construction: 去 + Place + Activity"
      },
      "explanation": {
        "hanzi": "一个句子里可以有两个动词短语连在一起。“去 + 地方 + 动词短语”表示去某个地方做什么，第二个动词短语说明去的目的。否定的时候，“不”放在“去”的前面。",
        "english": "A Chinese sentence can string two verb phrases together. In 去 + place + verb phrase, the second part tells you why you go there: 去学校看书 \"go to school to read\". To negate it, put 不 before 去."
      },
      "examples": [
        {
          "hanzi": "我去学校看书。",
          "pinyin": "Wǒ qù xuéxiào kàn shū.",
          "english": "I'm going to school to read."
        },
        {
          "hanzi": "明天我们去王明家做菜。",
          "pinyin": "Míngtiān wǒmen qù Wáng Míng jiā zuò cài.",
          "english": "Tomorrow we're going to Wang Ming's place to cook."
        },
        {
          "hanzi": "你去学校做什么？",
          "pinyin": "Nǐ qù xuéxiào zuò shénme?",
          "english": "What are you going to school for?"
        },
        {
          "hanzi": "马克不去学校看书。",
          "pinyin": "Mǎkè bú qù xuéxiào kàn shū.",
          "english": "Mark isn't going to school to read."
        }
      ],
      "patternTable": {
