  "pinyinSection": {
    "drills": [
      {
        "number": 1,
        "title": {
          "hanzi": "zh、ch、sh、r 和 z、c、s",
          "english": "zh, ch, sh, r versus z, c, s"
        },
        "explanation": {
          "hanzi": "发 z、c、s 时，舌尖放在上牙后面；发 zh、ch、sh、r 时，舌尖向上卷起，靠近口腔上部。c 和 ch 是送气音。",
          "english": "For z, c, s the tip of the tongue rests just behind the upper front teeth — flat and forward. For zh, ch, sh, r the tongue tip curls up and back toward the roof of the mouth. c and ch are aspirated: a puff of air follows. Listen to the contrast in each pair."
        },
        "syllables": [
          "zī — zhī",
          "cī — chī",
          "sī — shī",
          "zǎo — zhǎo",
          "cài — chài",
          "sān — shān",
          "zuò — zhuō",
          "rì",
          "rén",
          "ròu"
        ]
