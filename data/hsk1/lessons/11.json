  "notes": [
    {
      "id": "hsk1_11_g_telling_time",
      "number": 1,
      "title": {
        "hanzi": "时间的表达",
        "english": "Telling the Time"
      },
      "explanation": {
        "hanzi": "说时间用\"……点……分\"。问时间用\"几点\"：现在几点？两点说\"两点\"，不说\"二点\"。",
        "english": "Hours are counted with 点 (o'clock) and minutes with 分: 8点15分 = bā diǎn shíwǔ fēn (8:15). To ask the time, say 现在几点? Note that 2 o'clock is 两点 liǎng diǎn, not 二点. On the hour you can stop after 点: 9点 (9:00)."
      },
      "examples": [
        {
          "hanzi": "现在几点？",
          "pinyin": "Xiànzài jǐ diǎn?",
          "english": "What time is it now?"
        },
        {
          "hanzi": "现在8点。",
          "pinyin": "Xiànzài bā diǎn.",
          "english": "It's 8 o'clock."
        },
        {
          "hanzi": "现在10点15分。",
          "pinyin": "Xiànzài shí diǎn shíwǔ fēn.",
          "english": "It's 10:15."
        },
        {
          "hanzi": "电影几点？",
          "pinyin": "Diànyǐng jǐ diǎn?",
          "english": "What time is the film?"
        }
      ],
