    {
      "id": "hsk1_11_g_time_adverbial",
      "number": 2,
      "title": {
        "hanzi": "时间词作状语",
        "english": "Time Words Before the Verb"
      },
      "explanation": {
        "hanzi": "表示时间的词语要放在动词前面，可以放在主语后面，也可以放在句子开头，但不能放在句子最后。",
        "english": "In Chinese, \"when\" comes before \"what you do\". A time word goes either right after the subject or at the very start of the sentence — never at the end as in English. 我们中午12点吃饭 and 中午12点我们吃饭 are both correct; *我们吃饭中午12点 is wrong."
      },
      "examples": [
        {
          "hanzi": "我们中午12点吃饭。",
          "pinyin": "Wǒmen zhōngwǔ shí'èr diǎn chī fàn.",
          "english": "We eat at 12 noon."
        },
        {
          "hanzi": "明天下午我去商店。",
          "pinyin": "Míngtiān xiàwǔ wǒ qù shāngdiàn.",
          "english": "I'm going to the shop tomorrow afternoon."
        },
        {
          "hanzi": "她星期六看电影。",
          "pinyin": "Tā xīngqīliù kàn diànyǐng.",
          "english": "She's watching a film on Saturday."
        },
        {
          "hanzi": "你几点回家？",
          "pinyin": "Nǐ jǐ diǎn huí jiā?",
          "english": "What time are you going home?"
        }
      ],
      "patternTable": {
        "columns": [
          "时间 (time)",
          "主语 (subject)",
          "时间 (time)",
          "动词 (verb phrase)"
        ],
        "rows": [
          [
            "",
            "我们",
            "中午12点",
            "吃饭"
          ],
          [
            "中午12点",
            "我们",
            "",
            "吃饭"
          ],
          [
            "",
            "他",
            "明天",
            "回北京"
          ]
        ]
      }
    },
    {
      "id": "hsk1_11_g_qian",
      "number": 3,
      "title": {
        "hanzi": "\"前\"表示时间",
        "english": "\"前\" Meaning \"Before\" or \"Ago\""
      },
      "explanation": {
        "hanzi": "\"前\"放在时间段或动作后面：\"数量 + 时间 + 前\"表示\"……以前\"（三天前）；\"动词短语 + 前\"表示做这件事以前（吃饭前）。",
        "english": "前 comes after the expression it modifies — the opposite of English. Number + time unit + 前 means \"... ago\": 三天前 (three days ago). Verb phrase + 前 means \"before doing ...\": 吃饭前 (before eating)."
      },
      "examples": [
        {
          "hanzi": "三天前，她在北京。",
          "pinyin": "Sān tiān qián, tā zài Běijīng.",
          "english": "Three days ago she was in Beijing."
        },
        {
          "hanzi": "五年前，我是学生。",
          "pinyin": "Wǔ nián qián, wǒ shì xuésheng.",
          "english": "Five years ago I was a student."
        },
        {
          "hanzi": "吃饭前，我们喝茶。",
          "pinyin": "Chī fàn qián, wǒmen hē chá.",
          "english": "Before the meal, we drink tea."
        },
        {
          "hanzi": "回家前，我去商店买杯子。",
          "pinyin": "Huí jiā qián, wǒ qù shāngdiàn mǎi bēizi.",
          "english": "Before going home, I'm going to the shop to buy a cup."
        }
      ]
    }
  ],
