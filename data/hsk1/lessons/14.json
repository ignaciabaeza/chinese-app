  "notes": [
    {
      "id": "hsk1_14_g_le",
      "number": 1,
      "title": {
        "hanzi": "\"了\"表示动作完成",
        "english": "\"了\" Marking a Completed Action"
      },
      "explanation": {
        "hanzi": "动词后面加\"了\"，表示这个动作已经发生、完成了。动词后的宾语前面常常有数量词，比如\"买了三个苹果\"。否定的时候用\"没（有）+ 动词\"，不再用\"了\"。问句可以说\"……了吗？\"。",
        "english": "Put \"了\" right after a verb to show that the action has happened or been completed. The object after \"verb + 了\" usually carries a number or quantity, e.g. 买了三个苹果 (bought three apples). To say an action did NOT happen, use \"没 + verb\" and drop 了 completely: 我没买 (I didn't buy it), never *我没买了. To ask, add 吗: ……了吗？"
      },
      "examples": [
        {
          "hanzi": "我昨天买了三个苹果。",
          "pinyin": "Wǒ zuótiān mǎile sān ge píngguǒ.",
          "english": "I bought three apples yesterday."
        },
        {
          "hanzi": "王明上午看了一个电影。",
          "pinyin": "Wáng Míng shàngwǔ kànle yí ge diànyǐng.",
          "english": "Wang Ming watched a film this morning."
        },
        {
          "hanzi": "你吃饭了吗？",
          "pinyin": "Nǐ chī fàn le ma?",
          "english": "Have you eaten?"
        },
        {
          "hanzi": "我今天没买衣服。",
          "pinyin": "Wǒ jīntiān méi mǎi yīfu.",
          "english": "I didn't buy any clothes today."
        }
      ],
      "patternTable": {
        "columns": [
          "Subject",
          "Verb + 了 / 没 + Verb",
          "Object"
        ],
        "rows": [
          [
            "我",
            "买了",
            "不少东西"
          ],
          [
            "安娜",
            "喝了",
            "一杯茶"
          ],
          [
            "马克",
            "没买",
            "苹果"
          ]
        ]
      }
    },
    {
      "id": "hsk1_14_g_hou",
      "number": 2,
      "title": {
        "hanzi": "名词\"后\"",
        "english": "The Noun \"后\" (after, later)"
      },
      "explanation": {
        "hanzi": "\"后\"放在表示时间或事情的词语后面，意思是\"在这个时间或这件事以后\"。\"时间/事情 + 后\"一般放在主语前面或主语后面、动词前面。",
        "english": "\"后\" goes AFTER a time word or an event and means \"after that / later\": 10分钟后 (in ten minutes), 吃饭后 (after eating). Note the word order is the opposite of English: the time comes first, 后 comes last. The whole phrase sits before the verb, either before or after the subject."
      },
      "examples": [
        {
          "hanzi": "20分钟后我开车去商店。",
          "pinyin": "Èrshí fēnzhōng hòu wǒ kāi chē qù shāngdiàn.",
          "english": "In 20 minutes I'll drive to the shops."
        },
        {
          "hanzi": "吃饭后，我们去看电影吧。",
          "pinyin": "Chī fàn hòu, wǒmen qù kàn diànyǐng ba.",
          "english": "Let's go and see a film after we eat."
        },
        {
          "hanzi": "他三天后回来。",
          "pinyin": "Tā sān tiān hòu huílai.",
          "english": "He'll come back in three days."
        },
        {
          "hanzi": "下午五点后我在家。",
          "pinyin": "Xiàwǔ wǔ diǎn hòu wǒ zài jiā.",
          "english": "I'm at home after five in the afternoon."
        }
      ],
      "patternTable": {
        "columns": [
          "Time / Event",
          "后",
          "Subject + Verb"
        ],
        "rows": [
          [
            "10分钟",
            "后",
            "我回来"
          ],
          [
            "吃饭",
            "后",
            "我们去商店"
          ],
          [
            "三天",
            "后",
            "他开车去北京"
          ]
        ]
      }
    },
    {
      "id": "hsk1_14_g_a",
      "number": 3,
      "title": {
        "hanzi": "语气助词\"啊\"",
        "english": "The Modal Particle \"啊\""
      },
      "explanation": {
        "hanzi": "\"啊\"用在句子末尾，读轻声，让语气更热情、更自然，常常表示同意、肯定或者感叹。比如\"好啊！\"\"是啊。\"\"很漂亮啊！\"",
        "english": "\"啊\" (neutral tone) at the end of a sentence adds warmth and feeling. It often shows agreement (好啊！Sure!), confirmation (是啊。Yes, indeed.) or admiration/surprise (很漂亮啊！So pretty!). Without 啊 the same sentence can sound flat or even a little cold."
      },
      "examples": [
        {
          "hanzi": "我们一起去吧？——好啊！",
          "pinyin": "Wǒmen yìqǐ qù ba? — Hǎo a!",
          "english": "Shall we go together? — Sure!"
        },
        {
          "hanzi": "你的衣服很漂亮啊！",
          "pinyin": "Nǐ de yīfu hěn piàoliang a!",
          "english": "Your clothes are really pretty!"
        },
        {
          "hanzi": "今天很热啊！",
          "pinyin": "Jīntiān hěn rè a!",
          "english": "It's so hot today!"
        },
        {
          "hanzi": "你喜欢喝茶吗？——是啊，我很喜欢。",
          "pinyin": "Nǐ xǐhuan hē chá ma? — Shì a, wǒ hěn xǐhuan.",
          "english": "Do you like tea? — Yes, I really do."
        }
      ]
    },
    {
      "id": "hsk1_14_g_dou",
      "number": 4,
      "title": {
        "hanzi": "副词\"都\"",
        "english": "The Adverb \"都\" (all, both)"
      },
      "explanation": {
        "hanzi": "\"都\"表示前面说到的人或东西全部一样，意思是\"全部\"。\"都\"一定放在动词或形容词前面，不能放在主语前面。否定时\"都不/都没\"表示全部否定。",
        "english": "\"都\" means \"all\" or \"both\" and refers back to the people or things mentioned BEFORE it. It always goes right before the verb or adjective, never before the subject: 我们都是学生 (We are all students), not *都我们是学生. 都不 / 都没 means \"none of them\"."
      },
      "examples": [
        {
          "hanzi": "安娜和马克都是学生。",
          "pinyin": "Ānnà hé Mǎkè dōu shì xuésheng.",
          "english": "Anna and Mark are both students."
        },
        {
          "hanzi": "这些苹果都很好吃。",
          "pinyin": "Zhèxiē píngguǒ dōu hěn hǎochī.",
          "english": "All of these apples are delicious."
        },
        {
          "hanzi": "我们都喜欢中国菜。",
          "pinyin": "Wǒmen dōu xǐhuan Zhōngguó cài.",
          "english": "We all like Chinese food."
        },
        {
          "hanzi": "他们都没去商店。",
          "pinyin": "Tāmen dōu méi qù shāngdiàn.",
          "english": "None of them went to the shops."
        }
      ],
      "patternTable": {
        "columns": [
          "Subject (plural)",
          "都",
          "Verb / Adjective"
        ],
        "rows": [
