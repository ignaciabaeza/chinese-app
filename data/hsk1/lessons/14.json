  "pinyinSection": {
    "drills": [
      {
        "number": 1,
        "title": {
          "hanzi": "双音节词的声调组合",
          "english": "Tone Pairs in Two-Syllable Words"
        },
        "explanation": {
          "hanzi": "汉语里很多词有两个音节。两个声调放在一起一共有16种组合。按第一个音节的声调分成四组练习，注意每个音节的声调都要读完整。两个三声在一起时，第一个读成二声。",
          "english": "Most Chinese words have two syllables, and the four tones combine into 16 tone pairs. Practise them in four groups, sorted by the tone of the first syllable, and give each syllable its full tone. Remember: when two third tones meet, the first one is said as a second tone (shuǐguǒ → shuíguǒ)."
        },
        "subRules": [
          {
            "rule": {
              "hanzi": "第一声 + 一、二、三、四声",
              "english": "First tone + 1st / 2nd / 3rd / 4th tone"
            },
            "examples": [
