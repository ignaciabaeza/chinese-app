  "pinyinSection": {
    "drills": [
      {
        "number": 1,
        "title": {
          "hanzi": "“不”的变调",
          "english": "Tone changes of 不"
        },
        "explanation": {
          "hanzi": "“不”本来读第四声 bù。在第四声前面，“不”读第二声 bú；在第一、二、三声前面，还是读 bù。",
          "english": "On its own, 不 is fourth tone: bù. When it comes before another fourth-tone syllable, it changes to second tone: bú. Before first, second and third tones it stays bù. Pinyin is usually printed with the changed tone."
        },
        "subRules": [
          {
            "rule": {
              "hanzi": "不 + 第一、二、三声 → bù",
              "english": "不 before 1st, 2nd or 3rd tone → bù"
            },
            "examples": [
              {
                "pinyin": "bù hē",
                "english": "not drink"
              },
              {
                "pinyin": "bù chī",
                "english": "not eat"
              },
              {
                "pinyin": "bù lái",
                "english": "not come"
              },
              {
                "pinyin": "bù xiǎng",
                "english": "not want to"
              },
              {
                "pinyin": "bù mǎi",
                "english": "not buy"
              }
            ]
          },
          {
