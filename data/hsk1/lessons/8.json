  "notes": [
    {
      "id": "hsk1_8_g_xiang",
      "number": 1,
      "title": {
        "hanzi": "能愿动词“想”",
        "english": "The modal verb 想 (want to, would like to)"
      },
      "explanation": {
        "hanzi": "“想”放在动词前面，表示希望或打算做某事。否定形式是“不想”。",
        "english": "Put 想 in front of another verb to say what you want or would like to do. To say you don't want to do something, use 不想. In a yes/no question, simply add 吗 at the end."
      },
      "examples": [
        {
          "hanzi": "我想喝茶。",
          "pinyin": "Wǒ xiǎng hē chá.",
          "english": "I'd like some tea."
        },
        {
          "hanzi": "你想买什么？",
          "pinyin": "Nǐ xiǎng mǎi shénme?",
          "english": "What do you want to buy?"
        },
        {
          "hanzi": "马克不想吃米饭。",
          "pinyin": "Mǎkè bù xiǎng chī mǐfàn.",
          "english": "Mark doesn't want to eat rice."
        },
        {
          "hanzi": "下午你想去商店吗？",
          "pinyin": "Xiàwǔ nǐ xiǎng qù shāngdiàn ma?",
          "english": "Do you want to go to the shop this afternoon?"
        }
      ],
      "patternTable": {
